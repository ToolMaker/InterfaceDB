  <ItemGroup Condition="'$(TelemetryBuild)' == 'true'">
    <ProjectReference Include="../InterfaceDB.Transport/InterfaceDB.Transport.csproj" />
    <Compile Include="../StorageBenchmarks.Repository/BenchmarkTelemetry.cs" Link="BenchmarkTelemetry.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TelemetryBuild)' != 'true'">
    <Reference Include="$(BaselineDirectory)/*.dll" />
  </ItemGroup>
  <ItemGroup><Compile Include="../InterfaceDB.Transport.Tests/TestCertificates.cs" Link="TestCertificates.cs" /></ItemGroup>
</Project>
