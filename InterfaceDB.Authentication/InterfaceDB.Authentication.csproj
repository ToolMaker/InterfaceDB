<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>InterfaceDB.Authentication</PackageId>
    <Version>1.0.0-preview.16</Version>
    <Authors>ToolMaker</Authors>
    <Description>JWT validation and OAuth service token providers for InterfaceDB.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ToolMaker/InterfaceDB</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ToolMaker/InterfaceDB</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Preview 16 fixes File read/delete races and adds validated file leases, committed imports without application notification echoes, canonical integrity serialization, fresh committed inventories and composition capability gates. Existing data formats, durability, conflict protection and normal notifications are preserved. Upgrade guide: https://github.com/ToolMaker/InterfaceDB/blob/v1.0.0-preview.16/documentation/preview16-release-notes.md</PackageReleaseNotes>
    <RootNamespace>Idb.Authentication</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <None Update="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
