<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>InterfaceDB.Authentication</PackageId>
    <Version>1.0.0-preview.12</Version>
    <Authors>ToolMaker</Authors>
    <Description>JWT validation and OAuth service token providers for InterfaceDB.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ToolMaker/InterfaceDB</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ToolMaker/InterfaceDB</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Preview 12 establishes the reviewed storage and committed-cache baseline: corrected query/index/key behavior, compaction-safe scans, isolated committed cache reads and serializer-aware context work. Keep all InterfaceDB packages aligned. Read the compatibility and performance trade-offs at https://github.com/ToolMaker/InterfaceDB/blob/v1.0.0-preview.12/documentation/preview12-release-notes.md</PackageReleaseNotes>
    <RootNamespace>Idb.Authentication</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <None Update="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
