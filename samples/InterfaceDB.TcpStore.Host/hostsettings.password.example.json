{
  "bindAddress": "127.0.0.1",
  "port": 7443,
  "storeAlias": "catalogue",
  "dataDirectory": "./data/catalogue",
  "serverCertificatePath": "./secrets/server.pfx",
  "serverCertificatePasswordEnvironmentVariable": "IDB_SERVER_PFX_PASSWORD",
  "authenticationMode": "Provider",
  "dataAccessPolicy": "subject",
  "localAccounts": {
    "accounts": {
      "authority": "idb-local:catalogue-production",
      "accountMode": "MultipleAccounts",
      "creationMode": "Administrators",
      "creatorRoles": ["account-admin"],
      "creatorAccountIds": [],
      "newAccountRoles": ["database-user"],
      "sessionLifetime": "00:05:00",
      "maximumAccounts": 10000,
      "maximumConcurrentPasswordChecks": 2,
      "attemptsPerMinute": 60
    },
    "storageProvider": "SegmentCore",
    "storageDirectory": "./private/credentials",
    "encryptionMethod": "AesGcm",
    "encryptionKeyEnvironmentVariable": "IDB_CREDENTIAL_ENCRYPTION_KEY",
    "passwordHashingMethod": "Pbkdf2Sha256",
    "passwordHashIterations": 600000,
    "bootstrapUsername": "administrator",
    "bootstrapPasswordEnvironmentVariable": "IDB_BOOTSTRAP_PASSWORD"
  },
  "manifest": {
    "apiVersion": "InterfaceDB-remote-v1",
    "storageEngine": "SegmentCore",
    "storageFormat": "deployment-format-identity",
    "envelopeFormat": "deployment-envelope-identity",
    "contractIdentity": "Example.Catalogue",
    "contractVersion": "1",
    "contractSchemaHash": "deployment-contract-schema-hash",
    "implementationManifestHash": "deployment-implementation-manifest-hash",
    "indexDefinitionHash": "deployment-index-definition-hash",
    "approvedBuildIdentity": null
  },
  "maximumConnections": 16,
  "maximumEnumerationKeys": 100000,
  "maximumSubjectKeys": 10000,
  "maximumSessionLifetime": "00:05:00"
}
