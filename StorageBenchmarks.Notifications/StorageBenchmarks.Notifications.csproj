<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InterfaceDbSourceRoot Condition="'$(InterfaceDbSourceRoot)' == ''">$(MSBuildProjectDirectory)\..</InterfaceDbSourceRoot>
    <DefineConstants Condition="'$(NotificationBaseline)' == 'true'">$(DefineConstants);NOTIFICATION_BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(InterfaceDbSourceRoot)\Idb.Libraries\Idb.Libraries.csproj" />
    <ProjectReference Include="$(InterfaceDbSourceRoot)\InterfaceDB.Storage.SegmentCore\InterfaceDB.Storage.SegmentCore.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
</Project>
