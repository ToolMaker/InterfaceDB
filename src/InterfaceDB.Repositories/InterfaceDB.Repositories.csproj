<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>InterfaceDB.Commercial.Repositories</AssemblyName>
    <RootNamespace>Idb.Commercial.Repositories</RootNamespace>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Description>Repository composition, offline synchronization, peer replication and resumable provider-to-provider storage migration for InterfaceDB.</Description>
    <PackageTags>interfacedb;database;repository;storage</PackageTags>
    <PackageId>InterfaceDB.Repositories</PackageId>
    <Version>1.0.0-preview.18</Version>
    <Authors>ToolMaker</Authors>
    <Copyright>Copyright (c) 2026 Ernie Gunning</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ToolMaker/InterfaceDB</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ToolMaker/InterfaceDB</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Preview 18 adds opt-in authenticated TCP contract discovery and the optional Protobuf serializer package. Upgrade guide at https://github.com/ToolMaker/InterfaceDB/blob/v1.0.0-preview.18/documentation/preview18-release-notes.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Idb.Libraries/Idb.Libraries.csproj" />
  </ItemGroup>



  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
