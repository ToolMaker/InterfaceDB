<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>InterfaceDB</PackageId>
    <Version>1.0.0-preview.13</Version>
    <Authors>ToolMaker</Authors>
    <Description>Interface-first object repository and embedded object database for .NET 10.</Description>
    <PackageTags>interfacedb;repository;object-database;embedded-database;android;ios;maccatalyst</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ToolMaker/InterfaceDB</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ToolMaker/InterfaceDB</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Preview 13 adds DI-based user, tenant and group access policies, interface ownership validation and bounded partition indexing. Breaking TCP wire version 3 and cache identities require matching client/server updates. Storage durability and committed-read semantics are unchanged. Upgrade guide: https://github.com/ToolMaker/InterfaceDB/blob/v1.0.0-preview.13/documentation/preview13-release-notes.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="RadixForge" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
