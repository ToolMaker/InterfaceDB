<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <AssemblyName>InterfaceDB.Storage.SegmentCore</AssemblyName>
    <PackageId>InterfaceDB.Storage.SegmentCore</PackageId>
    <Version>1.0.0-preview.12</Version>
    <Authors>ToolMaker</Authors>
    <Description>High-throughput append-only SegmentCore storage provider for InterfaceDB.</Description>
    <PackageTags>interfacedb;storage;object-database;wal;append-only;android;ios;maccatalyst;macos</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ToolMaker/InterfaceDB</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ToolMaker/InterfaceDB</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Preview 12 establishes the reviewed storage and committed-cache baseline: corrected query/index/key behavior, compaction-safe scans, isolated committed cache reads and serializer-aware context work. Keep all InterfaceDB packages aligned. Read the compatibility and performance trade-offs at https://github.com/ToolMaker/InterfaceDB/blob/v1.0.0-preview.12/documentation/preview12-release-notes.md</PackageReleaseNotes>
    <RootNamespace>Idb.Storage.SegmentCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Idb.Libraries\Idb.Libraries.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
