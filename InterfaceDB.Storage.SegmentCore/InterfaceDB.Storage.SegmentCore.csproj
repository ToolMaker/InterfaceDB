<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <AssemblyName>InterfaceDB.Storage.SegmentCore</AssemblyName>
    <PackageId>InterfaceDB.Storage.SegmentCore</PackageId>
    <Version>1.0.0-preview.7</Version>
    <Authors>ToolMaker</Authors>
    <Description>High-throughput append-only SegmentCore storage provider for InterfaceDB.</Description>
    <PackageTags>interfacedb;storage;object-database;wal;append-only;android;ios;maccatalyst;macos</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ToolMaker/InterfaceDB</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ToolMaker/InterfaceDB</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Preview 7 adds revision-checked writes, retained editing, maintenance policies and optional independent-file compaction, plus faster complete-object scans. IDB6 writes require upgraded readers. Independent compaction explicitly upgrades engine format to 1.1; switching the option back does not downgrade it. Stop old writers and retain a verified pre-upgrade backup. See preview7-release-notes.md for qualification and limits.</PackageReleaseNotes>
    <RootNamespace>Idb.Storage.SegmentCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Idb.Libraries\Idb.Libraries.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\documentation\segment-core-storage-provider.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
